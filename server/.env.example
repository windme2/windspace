PORT=8080
NODE_ENV=development
API_URL=http://localhost:8080

# CORS Configuration
# Comma-separated list of allowed origins
# Development: http://localhost:5173
# Production: https://your-app.vercel.app,https://your-domain.com
CORS_ORIGIN=http://localhost:5173

# Admin Authentication
# Set strong credentials for production!
ADMIN_PASSWORD=your_secure_password

# JWT Secrets - Generate strong random strings for production
# Use: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-jwt-secret-key-change-this-to-something-very-secure
JWT_REFRESH_SECRET=your-refresh-secret-key-change-this-to-something-very-secure

# Supabase Configuration
# Get these from your Supabase project settings
SUPABASE_URL=your_supabase_project_url
SUPABASE_SERVICE_KEY=your_supabase_service_role_key
SUPABASE_ANON_KEY=your_supabase_anon_key

# Error Tracking (optional)
SENTRY_DSN=your-sentry-dsn
